{
 "etag": "\"cat-1\"",
 "ops": [
  {
   "op": "project.create",
   "group": "projects",
   "description": "Create a project",
   "permission": "project.create",
   "preview": true,
   "destructive": false,
   "args_schema": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "description": "project name",
      "minLength": 1
     },
     "key": {
      "type": "string",
      "description": "short key",
      "pattern": "^[A-Z][A-Z0-9]{1,9}$"
     },
     "process": {
      "type": "string",
      "description": "process template"
     },
     "product": {
      "type": "string",
      "description": "product"
     },
     "team": {
      "type": "string",
      "description": "team name",
      "format": "team"
     },
     "methodology": {
      "type": "string",
      "enum": [
       "scrum",
       "kanban",
       "waterfall",
       "hybrid"
      ]
     }
    },
    "required": [
     "name",
     "key"
    ],
    "additionalProperties": false
   },
   "example": {
    "args": {
     "name": "Payments",
     "key": "PAY",
     "methodology": "scrum"
    },
    "text": "new project Payments key PAY scrum"
   }
  },
  {
   "op": "project.update",
   "group": "projects",
   "description": "Update project fields",
   "permission": "project.write",
   "preview": false,
   "destructive": false,
   "args_schema": {
    "type": "object",
    "properties": {
     "project": {
      "type": "string",
      "description": "project key",
      "format": "project"
     },
     "name": {
      "type": "string"
     },
     "process": {
      "type": "string"
     },
     "product": {
      "type": "string"
     },
     "methodology": {
      "type": "string",
      "enum": [
       "scrum",
       "kanban",
       "waterfall",
       "hybrid"
      ]
     }
    },
    "required": [
     "project"
    ],
    "additionalProperties": false
   },
   "example": {
    "args": {
     "project": "WEB",
     "name": "Website 2"
    },
    "text": "rename project WEB to Website 2"
   }
  },
  {
   "op": "project.add_member",
   "group": "projects",
   "description": "Add a person to a project",
   "permission": "project.write",
   "preview": true,
   "destructive": false,
   "args_schema": {
    "type": "object",
    "properties": {
     "project": {
      "type": "string",
      "description": "project key",
      "format": "project"
     },
     "person": {
      "type": "string",
      "description": "@handle",
      "format": "person"
     },
     "role": {
      "type": "string",
      "enum": [
       "member",
       "lead",
       "viewer",
       "owner"
      ]
     }
    },
    "required": [
     "project",
     "person",
     "role"
    ],
    "additionalProperties": false
   },
   "example": {
    "args": {
     "project": "WEB",
     "person": "@sara",
     "role": "member"
    },
    "text": "add @sara to WEB as member"
   }
  },
  {
   "op": "project.plan.create",
   "group": "projects",
   "description": "Create a top-down plan (phases, milestones, deliverables)",
   "permission": "project.write",
   "preview": true,
   "destructive": false,
   "args_schema": {
    "type": "object",
    "properties": {
     "project": {
      "type": "string",
      "description": "project key",
      "format": "project"
     },
     "plan": {
      "type": "object",
      "description": "plan payload"
     }
    },
    "required": [
     "project",
     "plan"
    ],
    "additionalProperties": false
   },
   "example": {
    "args": {
     "project": "WEB",
     "plan": {
      "phases": [
       {
        "name": "Build"
       }
      ]
     }
    },
    "text": "plan WEB with a Build phase"
   }
  },
  {
   "op": "project.baseline.capture",
   "group": "projects",
   "description": "Capture a baseline of the current plan",
   "permission": "project.write",
   "preview": false,
   "destructive": false,
   "args_schema": {
    "type": "object",
    "properties": {
     "project": {
      "type": "string",
      "description": "project key",
      "format": "project"
     },
     "name": {
      "type": "string",
      "description": "baseline name"
     }
    },
    "required": [
     "project"
    ],
    "additionalProperties": false
   },
   "example": {
    "args": {
