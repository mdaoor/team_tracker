     "name": "Q4 baseline"
    },
    "text": "baseline WEB as Q4 baseline"
   }
  },
  {
   "op": "item.create",
   "group": "items",
   "description": "Create an overlay item (epic, deliverable, task)",
   "permission": "item.write_overlay",
   "preview": true,
   "destructive": false,
   "args_schema": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1
     },
     "type": {
      "type": "string",
      "enum": [
       "epic",
       "story",
       "task",
       "bug",
       "deliverable",
       "milestone"
      ]
     },
     "project": {
      "type": "string",
      "description": "project key",
      "format": "project"
     },
     "parent": {
      "type": "string",
      "description": "parent item key",
      "format": "item",
      "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
     },
     "priority": {
      "type": "string",
      "enum": [
       "lowest",
       "low",
       "medium",
       "high",
       "critical"
      ]
     },
     "description": {
      "type": "string"
     }
    },
    "required": [
     "title",
     "type",
     "project"
    ],
    "additionalProperties": false
   },
   "example": {
    "args": {
     "title": "Checkout redesign",
     "type": "epic",
     "project": "WEB"
    },
    "text": "new epic Checkout redesign under WEB"
   }
  },
  {
   "op": "item.update",
   "group": "items",
   "description": "Update item fields",
   "permission": "item.write_overlay",
   "preview": false,
   "destructive": false,
   "args_schema": {
    "type": "object",
    "properties": {
     "key": {
      "type": "string",
      "description": "item key, e.g. WEB-101",
      "format": "item",
      "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
     },
     "fields": {
      "type": "object",
      "description": "fields to change"
     }
    },
    "required": [
     "key",
     "fields"
    ],
    "additionalProperties": false
   },
   "example": {
    "args": {
     "key": "WEB-1",
     "fields": {
      "title": "Better title"
     }
    },
    "text": "rename WEB-1 to Better title"
   }
  },
  {
   "op": "item.reparent",
   "group": "items",
   "description": "Move items under a new parent",
   "permission": "item.write_overlay",
   "preview": true,
   "destructive": false,
   "args_schema": {
    "type": "object",
    "properties": {
     "keys": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "item key, e.g. WEB-101",
       "format": "item",
       "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
      },
      "description": "item keys",
      "minItems": 1
     },
     "parent": {
      "type": "string",
      "description": "new parent key",
      "format": "item",
      "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
     }
    },
    "required": [
     "keys",
     "parent"
    ],
    "additionalProperties": false
   },
   "example": {
    "args": {
     "keys": [
      "WEB-2",
      "WEB-3"
     ],
     "parent": "WEB-1"
    },
    "text": "move WEB-2 and WEB-3 under WEB-1"
   }
  },
  {
   "op": "item.merge",
   "group": "items",
   "description": "Merge several items into one (sources are soft-deleted)",
   "permission": "item.write_overlay",
   "preview": true,
   "destructive": true,
   "args_schema": {
    "type": "object",
    "properties": {
     "sources": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "item key, e.g. WEB-101",
       "format": "item",
       "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
      },
      "description": "items to merge",
      "minItems": 2
     },
     "target": {
      "type": "string",
      "description": "keep this item",
      "format": "item",
      "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
     },
     "new_title": {
      "type": "string",
      "description": "or create a new merged item with this title"
     },
     "allow_cross_project": {
      "type": "boolean"
     }
    },
    "required": [
     "sources"
    ],
    "additionalProperties": false,
    "anyOf": [
     {
      "required": [
       "target"
      ]
     },
     {
      "required": [
       "new_title"
      ]
     }
    ]
   },
   "example": {
    "args": {
     "sources": [
      "WEB-101",
      "WEB-105"
     ],
     "target": "WEB-101"
    },
    "text": "merge WEB-101 and WEB-105"
   }
  },
  {
