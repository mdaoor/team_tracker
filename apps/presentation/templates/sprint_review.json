{
  "schema_version": 1,
  "key": "sprint_review",
  "version": 1,
  "name": "Sprint review",
  "description": "Delivery, flow, who finished what, what is coming up.",
  "scope_types": [
    "workspace",
    "product",
    "project",
    "team",
    "person"
  ],
  "params": [],
  "slides": [
    {
      "kind": "title",
      "title_template": "Sprint review",
      "config": {},
      "requires": "plan",
      "render_empty": "placeholder",
      "layout": "full"
    },
    {
      "kind": "kpis",
      "title_template": "Delivery",
      "config": {},
      "requires": "activity",
      "render_empty": "note",
      "layout": "full"
    },
    {
      "kind": "pipeline",
      "title_template": "Flow",
      "config": {},
      "requires": "activity",
      "render_empty": "note",
      "layout": "full"
    },
    {
      "kind": "explorer",
      "title_template": "Done by person",
      "config": {
        "dimA": "assignee",
        "measure": "wt"
      },
      "requires": "activity",
      "render_empty": "note",
      "layout": "full"
    },
    {
      "kind": "radar",
      "title_template": "Coming up",
      "config": {
        "days": 7
      },
      "requires": "activity",
      "render_empty": "note",
      "layout": "full"
    },
    {
      "kind": "insight",
      "title_template": "Summary",
      "config": {},
      "requires": "both",
      "render_empty": "note",
      "layout": "full"
    }
  ]
}
