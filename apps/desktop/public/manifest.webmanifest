{
  "name": "Team Tracker - My time",
  "short_name": "My time",
  "description": "Plan your day, run a timer and send the work you choose to Team Tracker. Works offline; Mobile Lite keeps your plan in this browser.",
  "start_url": "./mobile.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
