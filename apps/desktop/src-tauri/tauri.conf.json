{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Team Tracker",
  "version": "0.1.0",
  "identifier": "com.teamtracker.desktop",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "palette", "title": "Team Tracker", "width": 640, "height": 420, "decorations": false, "alwaysOnTop": true, "visible": false, "center": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "externalBin": ["binaries/tt-sidecar"] },
  "plugins": {}
}
