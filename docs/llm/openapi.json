            "type": "object"
          },
          "rules": {
            "items": {
              "type": "string"
            },
            "title": "Rules",
            "type": "array"
          },
          "texts": {
            "items": {
              "type": "string"
            },
            "title": "Texts",
            "type": "array"
          },
