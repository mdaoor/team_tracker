{
  "$defs": {
    "SlideIn": {
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "layout": {
          "default": "full",
          "enum": [
            "full",
            "split",
            "grid"
          ],
          "title": "Layout",
          "type": "string"
        },
        "live": {
          "default": false,
          "title": "Live",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SlideIn",
      "type": "object"
    }
  },
  "description": "Shape of `presentation` inside `GET /presentations/{id}/data`.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "is_shared": {
      "title": "Is Shared",
      "type": "boolean"
    },
    "range_days": {
      "title": "Range Days",
      "type": "integer"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/SlideIn"
      },
      "title": "Slides",
      "type": "array"
    },
    "theme": {
      "title": "Theme",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "weight_scheme_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Weight Scheme Id"
    }
  },
  "required": [
    "id",
    "title",
    "scope",
    "range_days",
    "weight_scheme_id",
    "theme",
    "slides",
    "is_shared"
  ],
  "title": "_Presentation",
  "type": "object",
