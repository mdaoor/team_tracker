# Copy to .env. Every variable is read by tt_server.settings.Settings (prefix TT_).
TT_ENV=dev
TT_DATABASE_URL=postgresql+psycopg://tt:tt@localhost:5432/tt
# Accept the X-Debug-Actor header (dev only; real sign-in is OIDC / LDAP below)
TT_DEV_AUTH=1
TT_LOG_LEVEL=INFO
TT_LOG_JSON=true
# OTLP endpoint for traces; leave empty for no exporter
TT_OTLP_ENDPOINT=
# Feature flags (default off)
TT_FEATURES__INSIGHTS_LLM=false
TT_FEATURES__JIRA_SYNC=false
TT_FEATURES__HABITS_NIGHTLY=false
TT_FEATURES__SLACK_BOT=false
# Tests: point at an existing empty Postgres 16 DB instead of starting a testcontainer
# TT_TEST_DATABASE_URL=postgresql+psycopg://tt:tt@localhost:5432/tt_test
# Web dev server proxy target
# TT_API_URL=http://localhost:8000

# --- Sessions (web console)
# Signs the session cookie; MUST be a long random value outside dev (python -c "import secrets;print(secrets.token_urlsafe(48))")
TT_SESSION_SECRET=dev-insecure-session-secret
TT_SESSION_TTL_HOURS=12
# --- OIDC (Entra ID / ADFS / any provider); all three of issuer/client id/redirect are required to enable it
# TT_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# TT_OIDC_CLIENT_ID=
# TT_OIDC_CLIENT_SECRET=
# TT_OIDC_REDIRECT_URI=https://tracker.example.com/auth/callback
# --- Active Directory over LDAPS (NT accounts); see docs/security/active-directory.md
# TT_LDAP_URL=ldaps://dc1.corp.example.com:636
# TT_LDAP_CA_BUNDLE=/etc/tt/ca.pem
# TT_LDAP_BIND_DN=CN=svc-tt,OU=Service,DC=corp,DC=example,DC=com
# TT_LDAP_BIND_PASSWORD=
# TT_LDAP_BASE_DN=DC=corp,DC=example,DC=com
# --- HTTPS from a PEM pair (tt-admin serve); see docs/security/tls.md
# TT_TLS_CERTFILE=/etc/tt/tls/cert.pem
# TT_TLS_KEYFILE=/etc/tt/tls/key.pem
# TT_FORCE_HTTPS=true
# Clients (tt, desktop, Slack bot) trust an internal CA with:
# TT_CA_BUNDLE=/etc/tt/ca.pem

# --- LLM gateway (docs/llm/gateway.md); unset = no LLM-backed features on the server
# TT_LLM_GATEWAY_URL=https://llm.corp.example.com:8700
# TT_LLM_GATEWAY_TOKEN=
# TT_LLM_GATEWAY_CA_BUNDLE=/etc/tt/ca.pem
# TT_FEATURES__LLM_SUGGESTIONS=true
